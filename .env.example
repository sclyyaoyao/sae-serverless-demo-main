# =============================================================================
# 根目录 Compose：复制为 `.env` 后由 docker compose 读取（勿提交 .env）
# =============================================================================

# 对外 HTTP 端口（映射到 suke-front 容器 80）
SUKE_HTTP_PORT=8080

# Dify API 根地址（私有化或 Dify Cloud，勿在代码中写死）
# 示例：同机宿主机 Dify http://host.docker.internal:5001
DIFY_BASE_URL=http://host.docker.internal:5001

# 工作流 API Key：仅在部署环境注入，禁止写入仓库或前端 VITE_ 变量
DIFY_API_KEY=

# 传给 Dify 的用户标识（可区分调用方）
DIFY_USER=suke-api

# 调用 Dify / 代理下载的超时（秒）
REQUEST_TIMEOUT_SECONDS=600

# =============================================================================
# 本地开发 suke-front（Vite）：在 suke-front/.env.local 中配置
# =============================================================================
# 留空则通过 Vite 代理走同源 /api；直连后端时可设为 http://127.0.0.1:8000
# VITE_API_BASE_URL=
